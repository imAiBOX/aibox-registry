  "maintenance": {
    "upgrade": {
      "type": "rerun-dag",
      "probe": {
        "cmd": "\"%LOCALAPPDATA%\\Programs\\Cherry Studio\\Cherry Studio.exe\" --version",
        "expect": "(\\d+\\.\\d+\\.\\d+)"
      },
      "notes": "检查更新 = 本地 probe 版本 vs 探活 CI 记录的上游 latest（同一数据源）；升级 = 按路线重跑下载与静默安装（覆盖安装）。"
    },
    "uninstall": {
      "steps": [
        "Windows：设置 → 应用 → Cherry Studio → 卸载（NSIS 卸载器）",
        "macOS：退出 Cherry Studio 后把 Cherry Studio.app 移到废纸篓（或 rm -rf \"/Applications/Cherry Studio.app\"）",
        "按 dataPaths 删除配置与聊天数据（建议先导出/备份）"
      ],
      "residualPaths": [
        "~/AppData/Roaming/CherryStudio",
        "~/Library/Application Support/CherryStudio"
      ],
      "notes": "macOS 卸载 app 不自动删数据；便携版（portable.exe）数据在可执行文件同目录，TODO 实机取证。"
    },
    "dataPaths": [
      "~/AppData/Roaming/CherryStudio",
      "~/Library/Application Support/CherryStudio"
    ],
    "risk": {
      "onUninstall": "聊天记录、智能体与模型配置将被删除，建议先备份 / Your chats, agents and model settings will be deleted — back up first.",
      "backupFirst": true
    }
  },

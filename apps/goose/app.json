  "modelProviders": {
    "anthropic": {
      "label": "Anthropic official API (Claude)",
      "authType": "api-key",
      "keyFormat": "^sk-ant-[A-Za-z0-9_-]{40,}$",
      "configTarget": "~/.config/goose/config.yaml",
      "configFormat": "yaml",
      "configWritable": false,
      "getKeyUrl": "https://console.anthropic.com/settings/keys",
      "recommendedModels": [
        {
          "id": "claude-sonnet-4-5",
          "name": "Claude Sonnet 4.5",
          "note": "Balanced everyday default",
          "priceHint": "medium"
        },
        {
          "id": "claude-haiku-4-5",
          "name": "Claude Haiku 4.5",
          "note": "Fast and cheap for small edits",
          "priceHint": "low"
        }
      ],
      "notes": "Continue keeps all configuration in ~/.continue/config.yaml (macOS/Linux) or %USERPROFILE%\\.continue\\config.yaml (Windows) — official docs, measured 2026-11-14. Continue's own best practice is to reference API keys through environment variables instead of hardcoding them in the YAML; AiBOX never writes keys to disk."
    },
    "openai": {
      "label": "OpenAI official API",
      "authType": "api-key",
      "keyFormat": "^sk-(proj-)?[A-Za-z0-9_-]{20,}$",
      "configTarget": "~/.config/goose/config.yaml",
      "configFormat": "yaml",
      "configWritable": false,
      "getKeyUrl": "https://platform.openai.com/api-keys",
      "recommendedModels": [
        {
          "id": "gpt-5.1",
          "name": "GPT-5.1",
          "note": "Strong on complex tasks",
          "priceHint": "medium"
        }
      ],
      "notes": "Same config file as anthropic (local config.yaml, env-var reference recommended)."
    },
    "openrouter": {
      "label": "OpenRouter (one key, every model)",
      "authType": "api-key",
      "keyFormat": "^sk-or-v1-[A-Za-z0-9]{64}$",
      "configTarget": "~/.config/goose/config.yaml",
      "configFormat": "yaml",
      "configWritable": false,
      "getKeyUrl": "https://openrouter.ai/keys",
      "recommendedModels": [
        {
          "id": "anthropic/claude-sonnet-4",
          "name": "Claude Sonnet 4",
          "note": "Smart and balanced",
          "priceHint": "medium"
        },
        {
          "id": "google/gemini-2.5-flash",
          "name": "Gemini 2.5 Flash",
          "note": "Cheap and fast",
          "priceHint": "low"
        }
      ],
      "notes": "Same config file as anthropic."
    },
    "ollama": {
      "label": "Local Ollama models (free, offline, no key)",
      "authType": "local",
      "configTarget": "~/.config/goose/config.yaml",
      "configFormat": "yaml",
      "configWritable": false,
      "recommendedModels": [
        {
          "id": "qwen2.5-coder:7b",
          "name": "Qwen2.5 Coder 7B",
          "note": "Good free coding model, 8GB RAM",
          "priceHint": "free"
        },
        {
          "id": "llama3.2:3b",
          "name": "Llama 3.2 3B",
          "note": "Low-spec starter",
          "priceHint": "free"
        }
      ],
      "notes": "Continue officially documents Ollama as a local backend (docs.continue.dev guides, measured 2026-11-14); the endpoint is added in config.yaml or the config dropdown. No key involved."
    }

        "expect": "True"
      },
      "notes": "Run the new release installer over the existing user-level install; config and history survive."
    },
    "uninstall": {
      "steps": [
        "Run the Goose uninstaller (Start Menu) or remove %LOCALAPPDATA%\\Programs\\Goose",
        "Delete user data folders (see data paths)"
      ],
      "residualPaths": [
        "~/AppData/Roaming/Goose",
        "~/.config/goose",
        "~/Library/Application Support/Goose"
      ],
      "notes": "Provider keys and conversations live in the config/data folders — back up first."
    },
    "dataPaths": [
      "~/AppData/Roaming/Goose",
      "~/.config/goose",
      "~/Library/Application Support/Goose"
    ],
    "risk": {

  "maintenance": {
    "upgrade": {
      "type": "rerun-dag",
      "probe": {
        "cmd": "openclaw --version",
        "expect": "2026\\."
      },
      "notes": "检查更新 = 本地 probe 版本 vs 探活 CI 记录的上游 latest（同一数据源）；升级=重跑依赖 DAG（对应路线 routePlans）。"
    },
    "uninstall": {
      "steps": [
        "停止网关与托盘（openclaw gateway stop / 关闭 Windows Hub）",
        "卸载 Windows Hub（或 npm 路线执行 npm uninstall -g openclaw）",
        "按 residualPaths 清单删除残留（干净卸载）"
      ],
      "residualPaths": [
        "~/.config/openclaw",
        "~/.aibox/apps/openclaw/data",
        "~/.aibox/prefix",
        "~/.aibox/backup"
      ],
      "notes": "NSIS 静默卸载参数待实机取证（TODO）；~/.aibox/backup 属于通用备份目录，卸载时保留。"
    },
    "dataPaths": [
      "~/.config/openclaw/openclaw.json5",
      "~/.aibox/apps/openclaw/data"
    ],
    "risk": {
      "onUninstall": "配置与对话历史将被删除，建议先备份",
      "backupFirst": true
    }
  },

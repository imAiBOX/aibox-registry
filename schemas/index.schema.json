{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://aibox.im/schemas/index.schema.json",
  "title": "aibox-registry index",
  "description": "Application index (source for the aibox.im /apps directory). Spec: see docs.",
  "type": "object",
  "required": ["registryVersion", "generatedAt", "apps"],
  "properties": {
    "registryVersion": {
      "type": "string",
      "pattern": "^[0-9]{4}\\.[0-9]{2}\\.[0-9]{2}\\.[0-9]+$",
      "description": "Date-based registry version, bumped on every merged change."
    },
    "generatedAt": { "type": "string", "format": "date-time" },
    "note": { "type": "string" },
    "apps": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "name", "category", "tagline", "icon", "difficulty", "popularity", "platforms", "status"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]*$",
            "description": "Must equal the directory name under apps/."
          },
          "name": { "type": "string", "minLength": 1 },
          "category": {
            "type": "string",
            "enum": ["agent", "devtool", "productivity", "media", "utility", "other"]
          },
          "tagline": {
            "type": "object",
            "required": ["zh-CN", "en"],
            "propertyNames": { "type": "string", "pattern": "^[a-zA-Z-]+$" },
            "additionalProperties": { "type": "string", "minLength": 1 }
          },
          "icon": {
            "type": "string",
            "pattern": "^icons/[a-z0-9-]+\\.png$",
            "description": "Placeholder allowed (icons/*.png lands later)."
          },
          "difficulty": { "type": "integer", "minimum": 1, "maximum": 5 },
          "popularity": { "type": "integer", "minimum": 1, "maximum": 5 },
          "platforms": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": { "type": "string", "enum": ["windows", "macos"] }
          },
          "status": {
            "type": "string",
            "enum": ["stable", "beta", "experimental", "deprecated"]
          }
        }
      }
    }
  }
}
